{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/home/josephc/Pictures/acoolimagefolder/m1snalrl2whe1.jpeg",
    // auto = real image in kitty, colour blocks in Tilix/Alacritty
    "type": "auto",
    "width": 30,
    "height": 15,
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    // ANSI names, so the colours follow the Desk scheme's terminal palette
    "color": { "keys": "yellow", "title": "blue", "separator": "90" },
    "separator": "  "
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    { "type": "wm", "key": "WM" },
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "break",
    "colors"
  ]
}
